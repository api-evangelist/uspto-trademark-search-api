          "name": "Get Trademark by Serial Number",
          "request": {
            "name": "Get Trademark by Serial Number",
            "description": {
              "content": "Retrieves complete trademark information for a specific trademark using its USPTO serial number. Returns all filing details, status history, owner information, goods/services classifications, and prosecution history.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "trademarkBySerial",
                ":serialNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serialNumber",
                  "description": "(Required) The USPTO trademark serial number (8 digits)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
